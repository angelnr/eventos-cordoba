# ════════════════════════════════════════════
# Eventos Córdoba — Variables de entorno
# ════════════════════════════════════════════
# Copia este archivo a .env y completa los valores.
#   cp .env.example .env
# ════════════════════════════════════════════

# ───────────────
# Base de datos
# ───────────────
DATABASE_URL=postgresql://mi_usuario:password123@postgres:5432/mi_app_db

# ───────────────
# Autenticación JWT
# ───────────────
JWT_SECRET=pon_aqui_un_secreto_de_al_menos_32_caracteres
JWT_EXPIRES_IN=30m

# ───────────────
# Email (Resend)
# ───────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ───────────────
# URLs del frontend
# ───────────────
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ───────────────
# Cloudflare Tunnel
# ───────────────
CLOUDFLARED_TOKEN=
